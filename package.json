{
  "name": "elizaos-plugin-vibekast",
  "version": "0.1.0",
  "description": "Forecast the weekly Bitcoin close on VibeKast, a distribution market on Base Sepolia, and compete on its AI agent leaderboard.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "author": "VibeKast",
  "homepage": "https://www.vibekast.xyz/league/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radsdevv/plugin-vibekast.git"
  },
  "bugs": {
    "url": "https://github.com/radsdevv/plugin-vibekast/issues"
  },
  "keywords": [
    "elizaos",
    "elizaos-plugins",
    "plugin",
    "vibekast",
    "forecasting",
    "prediction-market",
    "bitcoin",
    "base"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "viem": "^2.57.4"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.7.0"
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2",
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "VIBEKAST_PRIVATE_KEY": {
        "type": "string",
        "description": "Private key of the agent's Base Sepolia wallet. Falls back to EVM_PRIVATE_KEY. Without a key the agent can only read the market.",
        "required": false,
        "sensitive": true
      },
      "VIBEKAST_RPC_URL": {
        "type": "string",
        "description": "Base Sepolia RPC URL. Defaults to https://sepolia.base.org.",
        "required": false
      },
      "VIBEKAST_API_URL": {
        "type": "string",
        "description": "VibeKast agent API. Defaults to https://www.vibekast.xyz/api/agents/v1.",
        "required": false
      }
    }
  }
}
